{
  "name": "@shim-works/spackle",
  "version": "0.1.0-beta.1",
  "description": "Browserslist-driven Babel polyfill provider for Chrome >= 38 / Safari >= 7, backed by lean hand-rolled polyfills instead of core-js",
  "license": "MIT",
  "author": "Sam Seabourn",
  "homepage": "https://github.com/shim-works/spackle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shim-works/spackle.git"
  },
  "bugs": {
    "url": "https://github.com/shim-works/spackle/issues"
  },
  "sideEffects": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./stable": {
      "types": "./dist/stable.d.ts",
      "import": "./dist/stable.mjs",
      "require": "./dist/stable.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.mjs",
      "require": "./dist/modules/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc",
    "lint:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test262": "node --max-old-space-size=3000 scripts/test262.mjs",
    "build:browser-tests": "node scripts/build-browser-tests.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "dependencies": {
    "@babel/helper-define-polyfill-provider": "^0.6.3",
    "@ungap/structured-clone": "^1.3.1",
    "core-js-compat": "^3.40.0",
    "promise-polyfill": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@types/node": "^22.10.2",
    "@vitest/browser": "^3.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "regenerator-runtime": "^0.14.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
